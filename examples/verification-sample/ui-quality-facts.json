    },
    {
      "categoryId": "Q07",
      "applicability": "applicable",
      "reason": "保存和搜索使用指针按钮，按适用WCAG最小目标尺寸核对并保留实际命中",
      "sourceRef": "https://www.w3.org/TR/WCAG22/#target-size-minimum"
