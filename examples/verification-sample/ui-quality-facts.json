      "sourceRef": "ui-driver.mjs#visualFaultSession"
    },
    {
      "categoryId": "Q05",
      "applicability": "applicable",
      "reason": "原生表单、名称和状态存在；使用成熟axe结果，保留不确定项，不宣称完全符合性",
