      "kind": "cli",
      "entrypointIds": [
        "cli-create",
        "cli-list",
        "cli-search",
        "cli-dry-run"
      ],
      "driverRef": "driver.mjs",
      "available": true,
      "real": true,
      "effects": {
        "writes": "test-artifacts",
        "network": true,
        "paid": false
      },
      "authorizationRef": "isolated-local-sample-no-paid-services",
