{
  "version": "1.2.0",
  "model": "jev-1.13.0",
  "dimensions": [
    {
      "id": "value",
      "name": "需求价值",
      "checks": [
        {
          "id": "value_1",
          "requirement": "目标与场景符合用户原始诉求和有效决定，区分主要结果与成本约束；不把安装工具、减少步骤或完善文档等手段当成目的，兴趣和学习也是有效价值。"
        },
        {
          "id": "value_2",
          "requirement": "频率、影响或预期收益足以支持投入；低频高后果场景不能只按频率否定。"
        },
        {
          "id": "value_3",
          "requirement": "对照现有办法或更简单可用的办法，新增方案解决了具体不足；对照可来自材料、已知经验或小检查，不要求先做大型实验。"
        },
        {
          "id": "value_4",
          "requirement": "成功结果可以观察；若为兴趣练习，不强制要求经济回报。"
        }
      ]
    },
    {
      "id": "workflow",
      "name": "场景与完整流程",
      "checks": [
        {
          "id": "workflow_1",
          "requirement": "触发条件、输入材料及其来源明确。"
        },
        {
          "id": "workflow_2",
          "requirement": "核心处理、人工检查和修改环节能够衔接。"
        },
        {
          "id": "workflow_3",
          "requirement": "输出能用于预定用途，保存或导出后的去向明确。"
        },
        {
          "id": "workflow_4",
          "requirement": "对实际会遇到的缺材料、重复输入和中断有合理处理安排。"
        },
        {
          "id": "workflow_5",
          "requirement": "流程符合用户实际设备、网络、账号和文件习惯。"
        },
        {
          "id": "workflow_6",
          "requirement": "整个任务没有为同一目的重复规划、审批、登记或复核；额外环节有具体质量收益，而非仅因用了多个工具就各走一遍。"
        }
      ]
    },
    {
      "id": "scope",
      "name": "功能范围与优先级",
      "checks": [
        {
          "id": "scope_1",
          "requirement": "核心任务所需能力完整，已确认的关键功能得到保留。"
        },
        {
          "id": "scope_2",
          "requirement": "必要功能、便利功能和低频功能有可解释的优先级。"
        },
        {
          "id": "scope_3",
          "requirement": "新增功能和中间层有具体价值；删减后仍满足已确认的质量与能力，必要防错约束、重复执行工具和回归检查有承接，不以减少层数替代达成目标。"
        },
        {
          "id": "scope_4",
          "requirement": "暂缓项目有可接受的人工替代路径，未形成难以持续的绕路。"
        }
      ]
    },
    {
      "id": "quality",
      "name": "结果质量与验收",
      "checks": [
        {
          "id": "quality_1",
          "requirement": "核心结果的正确性与完整性有可观察的判断标准。"
        },
        {
          "id": "quality_2",
          "requirement": "需要核对时能够追溯来源、关键规则或证据。"
        },
        {
          "id": "quality_3",
          "requirement": "验收覆盖实际代表性样本和相关异常；以减少错误为目标时，包含错误发现、修复后复测及值得防止复发的回归检查，不以记录完成替代实际结果。"
        },
        {
          "id": "quality_4",
          "requirement": "不可接受的错误和可以人工修正的情况有明确边界。"
        },
        {
          "id": "quality_5",
          "requirement": "若包含AI生成或分类，考虑无依据内容、遗漏、纠错及人工复核成本；不含AI时此项不适用。"
        }
      ]
    },
    {
      "id": "usability",
      "name": "易用性与操作负担",
      "checks": [
        {
          "id": "usability_1",
          "requirement": "启动和首次配置负担与个人使用频率相称。"
        },
        {
          "id": "usability_2",
          "requirement": "高频任务的输入、点击、切换和复制负担合理。"
        },
        {
          "id": "usability_3",
          "requirement": "运行、等待、完成、失败等状态清楚。"
        },
        {
          "id": "usability_4",
          "requirement": "错误反馈能帮助用户采取下一步行动。"
        },
        {
          "id": "usability_5",
          "requirement": "默认值、目录、快捷方式或批量操作贴合已知个人习惯，不强求通用产品功能。"
        },
        {
          "id": "usability_6",
          "requirement": "用户与代理选择工具、记住规则、切换上下文和维护资料的注意力负担合理；小任务不强制完整大流程。"
        }
      ]
    },
    {
      "id": "automation",
      "name": "自动化与人工分工",
      "checks": [
        {
          "id": "automation_1",
          "requirement": "稳定、重复且能核对的操作优先复用可靠程序或已有工具，减少模型每次临时推演和重写脚本；只加提示词不能冒充已经执行的自动约束。"
        },
        {
          "id": "automation_2",
          "requirement": "主观判断、模糊情况和重要取舍有合理人工参与点。"
        },
        {
          "id": "automation_3",
          "requirement": "控制方式与操作后果匹配；明确已授权的低风险动作不重复确认。"
        },
        {
          "id": "automation_4",
          "requirement": "需要时能暂停、纠错、跳过或接管流程。"
        },
        {
          "id": "automation_5",
          "requirement": "自动化减少了具体工作，或带来了值得额外投入的质量提升；原工作仍完整重做时只算额外复核，不能声称已节省该工作。"
        }
      ]
    },
    {
      "id": "architecture",
      "name": "架构合理性与资源兼容",
      "checks": [
        {
          "id": "architecture_1",
          "requirement": "界面、处理、存储各自的位置及云端依赖说明清楚。"
        },
        {
          "id": "architecture_2",
          "requirement": "断网行为与用户的离线要求一致。"
        },
        {
          "id": "architecture_3",
          "requirement": "组件及适配层与实际目标和规模相称；能直接防错或稳定执行关键动作的代码不是仅因增加组件就过重，参考文本、按需工具与常驻服务按实际采用部分判断。"
        },
        {
          "id": "architecture_4",
          "requirement": "方案适配实际系统、硬件、目录权限和安装条件。"
        },
        {
          "id": "architecture_5",
          "requirement": "如果依赖定时或后台运行，解释关机、休眠和退出后的行为；没有此依赖时该项不适用。"
        },
        {
          "id": "architecture_6",
          "requirement": "组件职责边界清楚，相同能力有主要负责者；公共可复用能力与项目自身业务规则各有所属，能说明新组件替代或补充哪一步、如何支撑目标。"
        },
        {
          "id": "architecture_7",
          "requirement": "多个技能或工作流的触发、指令和批准规则能共存，同一任务不会被多个总流程重复指挥；候选资源未启用不算已经发生冲突。"
        },
        {
          "id": "architecture_8",
          "requirement": "实际采用资源的运行依赖可共存，版本、全局配置、端口、浏览器会话或启动钩子的争用有处理；同名或数量多本身不证明冲突。"
        },
        {
          "id": "architecture_9",
          "requirement": "共享配置和数据的读写归属明确，不需要多套系统手工同步同一事实；相似记录若承担不同用途，关联与转换成本合理。"
        },
        {
          "id": "architecture_10",
          "requirement": "组件耦合及故障影响与任务相称，关闭非核心资源后核心任务仍有可用路径；避免为按需能力引入整套常驻依赖。"
        }
      ]
    },
    {
      "id": "data",
      "name": "数据管理",
      "checks": [
        {
          "id": "data_1",
          "requirement": "原始资料、处理结果、配置和历史记录的存储位置明确。"
        },
        {
          "id": "data_2",
          "requirement": "修改、删除、重新导入和重复数据的处理规则合理。"
        },
        {
          "id": "data_3",
          "requirement": "导入导出保留预定用途所需的内容、附件或关联信息。"
        },
        {
          "id": "data_4",
          "requirement": "备份与恢复安排匹配数据价值；用户明确接受的手动备份可合理，无须强制云备份。"
        },
        {
          "id": "data_5",
          "requirement": "迁移、停止使用和清理数据的路径可行。"
        }
      ]
    },
    {
      "id": "privacy",
      "name": "隐私与权限",
      "checks": [
        {
          "id": "privacy_1",
          "requirement": "文件、账号和系统权限限于实际用途并且说明清楚。"
        },
        {
          "id": "privacy_2",
          "requirement": "外发字段、接收服务和触发条件与用户的已知数据边界一致。"
        },
        {
          "id": "privacy_3",
          "requirement": "如涉及密钥或敏感资料，有相称的存储与日志处理；不凭空假定资料敏感。"
        },
        {
          "id": "privacy_4",
          "requirement": "本机、局域网或互联网访问入口与使用范围相称。"
        },
        {
          "id": "privacy_5",
          "requirement": "实际需要的授权撤回、凭据清理与访问关闭可操作；不强制无关的企业权限系统。"
        }
      ]
    },
    {
      "id": "recovery",
      "name": "稳定性与故障恢复",
      "checks": [
        {
          "id": "recovery_1",
          "requirement": "与场景有关的崩溃、断网、重启和中断有明确处理。"
        },
        {
          "id": "recovery_2",
          "requirement": "重复点击和重试不会造成不可接受的重复数据、费用或外部动作。"
        },
        {
          "id": "recovery_3",
          "requirement": "半途失败时的重要数据与任务状态保持可识别。"
        },
        {
          "id": "recovery_4",
          "requirement": "重要操作有相称的恢复、撤销或重做途径。"
        },
        {
          "id": "recovery_5",
          "requirement": "出现失败时保留足够定位信息，且不暴露不必要的私密资料。"
        }
      ]
    },
    {
      "id": "performance",
      "name": "性能与资源占用",
      "checks": [
        {
          "id": "performance_1",
          "requirement": "高频动作有符合实际使用需要的响应目标。"
        },
        {
          "id": "performance_2",
          "requirement": "评估依据来自实际数据规模及可预见的增长。"
        },
        {
          "id": "performance_3",
          "requirement": "资源占用与当前设备和同时使用其他软件的需要相容。"
        },
        {
          "id": "performance_4",
          "requirement": "如有后台工作，其闲置消耗、扫描和日志增长可接受；没有时不适用。"
        },
        {
          "id": "performance_5",
          "requirement": "长任务提供需要的进度和取消方式；短小任务不强制复杂调度。"
        }
      ]
    },
    {
      "id": "cost",
      "name": "总成本",
      "checks": [
        {
          "id": "cost_1",
          "requirement": "开发、配置、学习和迁移的一次性投入与目标相称。"
        },
        {
          "id": "cost_2",
          "requirement": "持续订阅、接口、存储等费用已识别；明确无外部收费时不虚构费用。"
        },
        {
          "id": "cost_3",
          "requirement": "检查、纠错、故障处理与维护的时间投入可接受。"
        },
        {
          "id": "cost_4",
          "requirement": "如有付费或重复运行，次数、重试与费用边界可控；没有付费时不强制预算设施。"
        },
        {
          "id": "cost_5",
          "requirement": "与现有工具或人工办法比较完整任务的准备、执行、复核及维护投入；可作注明依据的粗估，区分Codex用量、产品调用费和个人时间，将来核算的承诺不等于已有收益。"
        }
      ]
    },
    {
      "id": "maintenance",
      "name": "可维护性与退出能力",
      "checks": [
        {
          "id": "maintenance_1",
          "requirement": "常用目录、规则和服务设置的修改方式符合用户能力。"
        },
        {
          "id": "maintenance_2",
          "requirement": "关键依赖变化后的修复范围可控。"
        },
        {
          "id": "maintenance_3",
          "requirement": "启动、备份、恢复和常见问题有与复杂度相称的说明安排。"
        },
        {
          "id": "maintenance_4",
          "requirement": "若升级会影响重要数据，有适当兼容、备份或回退设计。"
        },
        {
          "id": "maintenance_5",
          "requirement": "可导出、关闭任务、停付和退出，并只为可预见变化预留扩展能力。"
        },
        {
          "id": "maintenance_6",
          "requirement": "升级、适配和规则同步的维护负担与收益相称；优先复用已有能力，保留能防止错误复发的有效约束，减少无独立用途的重复规则与登记。"
        }
      ]
    }
  ]
}
