{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "sharedVersion",
    "root",
    "authoritativeDocuments",
    "environmentRef",
    "checks"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "sharedVersion": {
      "enum": [
        "0.1.0",
        "0.2.0",
        "0.2.1",
        "0.3.0",
        "0.3.1",
        "0.4.1",
        "0.5.0",
        "0.5.1",
        "0.5.2",
        "0.5.3",
        "0.5.4",
        "0.5.5",
        "0.5.6",
        "0.5.7",
        "0.5.8",
        "0.5.9",
        "0.5.10",
        "0.5.11",
        "0.5.13",
        "0.5.14"
      ]
    },
    "root": {
      "type": "string"
    },
    "authoritativeDocuments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "environmentRef": {
      "type": "string",
      "minLength": 1
    },
    "environmentKeys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environmentFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "executable",
          "args",
          "cwd",
          "reviewed",
          "authorizationRef",
          "effects",
          "timeoutMs",
          "inputs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "executable": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string"
          },
          "reviewed": {
            "const": true
          },
          "authorizationRef": {
            "type": "string",
            "minLength": 1
          },
          "effects": {
            "type": "object",
            "required": [
              "writes",
              "network",
              "paid"
            ],
            "properties": {
              "writes": {
                "enum": [
                  "none",
                  "test-artifacts",
                  "business-data"
                ]
              },
              "network": {
                "type": "boolean"
              },
              "paid": {
                "type": "boolean"
              }
            }
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 100,
            "maximum": 300000
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "featureMapRef": {
      "type": "object",
      "required": [
        "schemaVersion",
        "path",
        "historyDir",
        "evidenceDir"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "historyDir": {
          "type": "string",
          "minLength": 1
        },
        "evidenceDir": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "uiQualityRef": {
      "type": "string",
      "minLength": 1
    },
    "featureMapDocument": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceRoutes": {
      "type": "array",
      "items": {
        "$ref": "acceptance.schema.json#/$defs/route"
      }
    },
    "controls": {
      "type": "object"
    },
    "engineeringRulesRef": {
      "type": "string",
      "minLength": 1
    }
  }
}
