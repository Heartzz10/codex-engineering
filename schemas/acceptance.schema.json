{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/schemas/acceptance.schema.json",
  "title": "Acceptance evidence (derived result is not trusted input)",
  "$ref": "#/$defs/evidence",
  "$defs": {
    "text": {"type":"string","minLength":1},
    "sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "method": {"enum":["baseline","ui","api","cli","background"]},
    "action": {"type":"object","required":["type"],"properties":{"type":{"$ref":"#/$defs/text"},"description":{"$ref":"#/$defs/text"}}},
    "assertion": {"type":"object","required":["id","operator","expected"],"properties":{"id":{"$ref":"#/$defs/text"},"operator":{"enum":["equals","equalsPath","includes","manual"]},"path":{"type":"string","pattern":"^(/.*)?$"},"expected":{}},"allOf":[{"if":{"properties":{"operator":{"enum":["equals","equalsPath","includes"]}}},"then":{"required":["path"]}}]},
    "fingerprint": {"type":"array","minItems":1,"items":{"type":"object","required":["path","sha256"],"properties":{"path":{"$ref":"#/$defs/text"},"sha256":{"$ref":"#/$defs/sha256"}}}},
    "target": {"type":"object","required":["targetId","entrypointId","roleRef","scenario","environmentRef","dataScopeRef"],"properties":{"targetId":{"$ref":"#/$defs/text"},"entrypointId":{"$ref":"#/$defs/text"},"roleRef":{"$ref":"#/$defs/text"},"scenario":{"$ref":"#/$defs/text"},"environmentRef":{"$ref":"#/$defs/text"},"dataScopeRef":{"$ref":"#/$defs/text"},"actions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/action"}},"assertions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/assertion"}}}},
    "judgment": {"type":"object","required":["assertionId","by","sourceRef","basis","uncertainties","result"],"properties":{"assertionId":{"$ref":"#/$defs/text"},"by":{"$ref":"#/$defs/text"},"sourceRef":{"$ref":"#/$defs/text"},"basis":{"$ref":"#/$defs/text"},"uncertainties":{"type":"array","items":{"$ref":"#/$defs/text"}},"result":{"type":"boolean"}}},
    "rawEvidence": {"type":"object","required":["path","sha256","type"],"properties":{"path":{"$ref":"#/$defs/text"},"sha256":{"$ref":"#/$defs/sha256"},"type":{"$ref":"#/$defs/text"}}},
    "observation": {"allOf":[{"$ref":"#/$defs/target"}],"required":["actions","actual"],"properties":{"actions":{"type":"array","minItems":1,"items":{"allOf":[{"$ref":"#/$defs/action"}],"required":["description"]}},"wait":{"type":"object","required":["status","signal"],"properties":{"status":{"enum":["completed","timed_out","failed"]},"signal":{"$ref":"#/$defs/text"}}},"actual":{"type":"object"},"judgments":{"type":"array","items":{"$ref":"#/$defs/judgment"}}}},
    "receipt": {"type":"object","required":["projectId","acId","acRevision","runId","method","observationSource","executedAt","implementationFingerprint","observations"],"properties":{"projectId":{"$ref":"#/$defs/text"},"acId":{"type":"string","pattern":"^AC-[0-9]{4,}$"},"acRevision":{"type":"integer","minimum":1},"runId":{"$ref":"#/$defs/text"},"method":{"$ref":"#/$defs/method"},"observationSource":{"enum":["tool_receipt","manual_attestation"]},"executedAt":{"type":"string","format":"date-time"},"implementationFingerprint":{"$ref":"#/$defs/fingerprint"},"observations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/observation"}},"attestation":{"type":"object","required":["by","sourceRef","basis"],"properties":{"by":{"$ref":"#/$defs/text"},"sourceRef":{"$ref":"#/$defs/text"},"basis":{"$ref":"#/$defs/text"}}},"example":{"const":false},"simulation":{"const":false}},"allOf":[{"if":{"properties":{"observationSource":{"const":"manual_attestation"}}},"then":{"required":["attestation"]}}]},
    "route": {"type":"object","required":["id","kind","entrypointIds","driverRef","available","real","effects","authorizationRef"],"properties":{"id":{"$ref":"#/$defs/text"},"kind":{"$ref":"#/$defs/method"},"entrypointIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}},"driverRef":{"$ref":"#/$defs/text"},"available":{"type":"boolean"},"real":{"type":"boolean"},"authorizationRef":{"$ref":"#/$defs/text"},"effects":{"type":"object","required":["writes","network","paid"],"properties":{"writes":{"enum":["none","test-artifacts","business-data"]},"network":{"type":"boolean"},"paid":{"type":"boolean"}}},"guards":{"type":"object","properties":{"permissionRef":{"$ref":"#/$defs/text"},"isolationRef":{"$ref":"#/$defs/text"},"budgetRef":{"$ref":"#/$defs/text"}}}}},
    "carryForward": {"type":"object","required":["evidenceId","fromAcId","fromAcRevision","fromTargetId","toAcId","toAcRevision","toTargetId","equivalenceBasis","sourceRef","recordedBy","currentVerification"],"properties":{"evidenceId":{"$ref":"#/$defs/text"},"fromAcId":{"$ref":"#/$defs/text"},"fromAcRevision":{"type":"integer","minimum":1},"fromTargetId":{"$ref":"#/$defs/text"},"toAcId":{"$ref":"#/$defs/text"},"toAcRevision":{"type":"integer","minimum":1},"toTargetId":{"$ref":"#/$defs/text"},"equivalenceBasis":{"$ref":"#/$defs/text"},"sourceRef":{"$ref":"#/$defs/text"},"recordedBy":{"$ref":"#/$defs/text"},"currentVerification":{"type":"object","required":["implementationFingerprint","roleRef","environmentRef","dataScopeRef"],"properties":{"implementationFingerprint":{"$ref":"#/$defs/fingerprint"},"roleRef":{"$ref":"#/$defs/text"},"environmentRef":{"$ref":"#/$defs/text"},"dataScopeRef":{"$ref":"#/$defs/text"}}}}},
    "evidence": {"type":"object","required":["projectId","featureId","acId","acRevision","targetIds","changeId","runId","method","observationSource","implementationFingerprint","environmentRef","roleRef","dataScopeRef","executedAt","rawEvidence","sourceRef","recordedBy","createdAt"],"properties":{"id":{"type":"string","pattern":"^EVD-[0-9]{4,}$"},"projectId":{"$ref":"#/$defs/text"},"featureId":{"type":"string","pattern":"^FEAT-[0-9]{4,}$"},"acId":{"type":"string","pattern":"^AC-[0-9]{4,}$"},"acRevision":{"type":"integer","minimum":1},"targetIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}},"changeId":{"type":"string","pattern":"^CHG-[0-9]{4,}$"},"runId":{"$ref":"#/$defs/text"},"method":{"$ref":"#/$defs/method"},"observationSource":{"enum":["tool_receipt","manual_attestation"]},"implementationFingerprint":{"$ref":"#/$defs/fingerprint"},"environmentRef":{"$ref":"#/$defs/text"},"roleRef":{"$ref":"#/$defs/text"},"dataScopeRef":{"$ref":"#/$defs/text"},"executedAt":{"type":"string","format":"date-time"},"rawEvidence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/rawEvidence"}},"sourceRef":{"$ref":"#/$defs/text"},"recordedBy":{"$ref":"#/$defs/text"},"createdAt":{"type":"string","format":"date-time"},"result":{"enum":["passed","failed","blocked","stale","not_run"]}}}
  }
}
